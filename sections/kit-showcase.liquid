{%- style -%}
  .kit-showcase {
    padding: 6rem 1.5rem;
    background: {{ settings.color_background }};
  }

  .kit-showcase__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 4rem;
  }

  .kit-showcase__heading {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 700;
    color: {{ settings.color_primary }};
    margin: 0 0 1rem;
  }

  .kit-showcase__subheading {
    font-size: 1.1rem;
    color: {{ settings.color_text_light }};
    margin: 0;
    line-height: 1.6;
  }

  .kit-showcase__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .kit-card {
    border-radius: 20px;
    padding: 2.5rem 2rem;
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .kit-card:hover {
    transform: translateY(-6px);
  }

  .kit-card--accent {
    background: linear-gradient(135deg, {{ settings.color_accent }}, color-mix(in srgb, {{ settings.color_accent }} 80%, #000));
    color: #fff;
  }

  .kit-card--primary {
    background: linear-gradient(135deg, {{ settings.color_primary }}, color-mix(in srgb, {{ settings.color_primary }} 80%, #000));
    color: #fff;
  }

  .kit-card--ai-purple {
    background: linear-gradient(135deg, {{ settings.color_ai_purple }}, color-mix(in srgb, {{ settings.color_ai_purple }} 80%, #000));
    color: #fff;
  }

  .kit-card__badge {
    display: inline-block;
    padding: 0.3rem 0.8rem;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.2);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
  }

  .kit-card__title {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 0.75rem;
  }

  .kit-card__description {
    font-size: 0.95rem;
    opacity: 0.9;
    line-height: 1.6;
    margin: 0 0 1.5rem;
  }

  .kit-card__items {
    font-size: 0.85rem;
    opacity: 0.8;
    margin: 0 0 1.5rem;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 8px;
  }

  .kit-card__price {
    font-size: 2rem;
    font-weight: 800;
    margin: 0 0 1.5rem;
  }

  .kit-card__price small {
    font-size: 0.8rem;
    font-weight: 400;
    opacity: 0.7;
    display: block;
  }

  .kit-card__btn {
    display: inline-block;
    padding: 0.8rem 1.8rem;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.2);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    border: 1.5px solid rgba(255, 255, 255, 0.3);
    transition: all 0.2s;
  }

  .kit-card__btn:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  @media (max-width: 749px) {
    .kit-showcase { padding: 4rem 1rem; }
    .kit-showcase__grid { grid-template-columns: 1fr; }
  }
{%- endstyle -%}

<section class="kit-showcase" id="kits-{{ section.id }}">
  <div class="kit-showcase__header">
    <h2 class="kit-showcase__heading">{{ section.settings.heading }}</h2>
    <p class="kit-showcase__subheading">{{ section.settings.subheading }}</p>
  </div>

  <div class="kit-showcase__grid">
    {%- for block in section.blocks -%}
      <div class="kit-card kit-card--{{ block.settings.color_scheme }}" {{ block.shopify_attributes }}>
        <span class="kit-card__badge">Kit</span>
        <h3 class="kit-card__title">{{ block.settings.title }}</h3>
        <p class="kit-card__description">{{ block.settings.description }}</p>
        <div class="kit-card__items">
          <strong>Includes:</strong> {{ block.settings.items }}
        </div>
        <p class="kit-card__price">
          {{ block.settings.price }}
          <small>Save 15-20% vs buying individually</small>
        </p>
        <a href="/collections/all" class="kit-card__btn">Order Kit</a>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Kit Showcase",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Full-Case Kits"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "One design → complete branded sets. Save 15-20% vs buying individually."
    }
  ],
  "blocks": [
    {
      "type": "kit",
      "name": "Kit",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Kit Title",
          "default": "Kit Name"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Kit description."
        },
        {
          "type": "text",
          "id": "items",
          "label": "Kit Items",
          "default": "Item 1, Item 2, Item 3"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "$199"
        },
        {
          "type": "select",
          "id": "color_scheme",
          "label": "Color Scheme",
          "options": [
            { "value": "accent", "label": "Orange" },
            { "value": "primary", "label": "Navy" },
            { "value": "ai-purple", "label": "AI Purple" }
          ],
          "default": "accent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kit Showcase",
      "blocks": [
        { "type": "kit", "settings": { "title": "Campaign Kit", "description": "Everything for your campaign.", "items": "Banner, T-shirt ×10, Cap ×10", "price": "$199", "color_scheme": "accent" } },
        { "type": "kit", "settings": { "title": "Brand Kit", "description": "Your brand, unified.", "items": "Business Card ×100, T-shirt ×5, Mug ×5", "price": "$149", "color_scheme": "primary" } },
        { "type": "kit", "settings": { "title": "Wedding Kit", "description": "Your special day, perfectly branded.", "items": "Invitation ×50, Favor ×30, T-shirt ×10", "price": "$249", "color_scheme": "ai-purple" } }
      ]
    }
  ]
}
{% endschema %}
