{% stylesheet %}
  .cart-page {
    padding-block: var(--space-2xl, 4rem);
    padding-inline: 1.5rem;
  }

  .cart-page__inner {
    max-inline-size: 900px;
    margin-inline: auto;
  }

  .cart-page__title {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 700;
    color: var(--color-primary, #1A1A2E);
    margin: 0 0 var(--space-2xl, 4rem);
  }

  .cart-item {
    display: grid;
    grid-template-columns: 80px 1fr auto;
    gap: var(--space-md, 1.5rem);
    padding-block: var(--space-md, 1.5rem);
    border-block-end: 1px solid var(--color-border, #E5E7EB);
    align-items: center;
  }

  .cart-item__image {
    inline-size: 80px;
    block-size: 80px;
    border-radius: var(--radius-sm, 8px);
    overflow: hidden;
    background: var(--color-bg-alt, #F9FAFB);
  }

  .cart-item__image img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .cart-item__info {
    min-inline-size: 0;
    overflow-wrap: break-word;
  }

  .cart-item__title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-primary, #1A1A2E);
    margin: 0 0 0.25rem;
  }

  .cart-item__variant {
    font-size: 0.85rem;
    color: var(--color-text-light, #6B7280);
    margin: 0 0 0.5rem;
  }

  .cart-item__price {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-accent, #FF6B35);
  }

  .cart-item__qty {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .cart-item__qty-input {
    inline-size: 60px;
    padding: 0.4rem;
    text-align: center;
    border: 1px solid var(--color-border, #E5E7EB);
    border-radius: var(--radius-sm, 8px);
    font-size: 0.9rem;
    font-family: inherit;
  }

  .cart-item__remove {
    background: none;
    border: none;
    color: var(--color-text-light, #6B7280);
    font-size: 0.85rem;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.2s ease;
  }

  .cart-item__remove:hover {
    color: var(--color-accent, #FF6B35);
  }

  .cart-footer {
    padding-block-start: var(--space-xl, 3rem);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-md, 1.5rem);
  }

  .cart-footer__subtotal {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary, #1A1A2E);
  }

  .cart-footer__checkout {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 2.5rem;
    border: none;
    border-radius: var(--radius-sm, 8px);
    background: var(--color-accent, #FF6B35);
    color: #fff;
    font-size: 1.05rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .cart-footer__checkout:hover {
    background: var(--color-primary, #1A1A2E);
  }

  .cart-empty {
    text-align: center;
    padding: var(--space-3xl, 6rem) 1.5rem;
  }

  .cart-empty__text {
    color: var(--color-text-light, #6B7280);
    font-size: 1.1rem;
    margin: 0 0 var(--space-lg, 2rem);
  }

  .cart-empty__link {
    display: inline-flex;
    padding: 0.75rem 2rem;
    border-radius: var(--radius-sm, 8px);
    background: var(--color-primary, #1A1A2E);
    color: #fff;
    font-weight: 600;
    transition: background 0.2s ease;
  }

  .cart-empty__link:hover {
    background: var(--color-accent, #FF6B35);
  }

  @media screen and (max-width: 749px) {
    .cart-item {
      grid-template-columns: 60px 1fr;
      gap: var(--space-sm, 1rem);
    }
    .cart-item__image {
      inline-size: 60px;
      block-size: 60px;
    }
    .cart-item__qty {
      grid-column: 1 / -1;
    }
    .cart-footer { align-items: stretch; }
    .cart-footer__checkout { inline-size: 100%; }
  }
{% endstylesheet %}

<section class="cart-page" id="CartPage-{{ section.id }}">
  <div class="cart-page__inner">
    <h1 class="cart-page__title">{{ 'cart.general.title' | t }}</h1>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        {%- for item in cart.items -%}
          <div class="cart-item">
            <div class="cart-item__image">
              {%- if item.image -%}
                {{ item.image | image_url: width: 160 | image_tag:
                  loading: 'lazy',
                  alt: item.title | escape,
                  width: item.image.width,
                  height: item.image.height
                }}
              {%- endif -%}
            </div>
            <div class="cart-item__info">
              <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
              {%- if item.variant.title != 'Default Title' -%}
                <p class="cart-item__variant">{{ item.variant.title }}</p>
              {%- endif -%}
              <p class="cart-item__price">{{ item.final_price | money }}</p>
            </div>
            <div class="cart-item__qty">
              <input
                type="number"
                class="cart-item__qty-input"
                name="updates[]"
                value="{{ item.quantity }}"
                min="0"
                aria-label="{{ 'products.product.quantity' | t }}"
              >
              <a href="{{ item.url_to_remove }}" class="cart-item__remove">
                {{ 'cart.general.remove' | t }}
              </a>
            </div>
          </div>
        {%- endfor -%}

        <div class="cart-footer">
          <p class="cart-footer__subtotal">
            {{ 'cart.general.subtotal' | t }}: {{ cart.total_price | money }}
          </p>
          <button type="submit" name="checkout" class="cart-footer__checkout">
            {{ 'cart.general.checkout' | t }}
          </button>
        </div>
      </form>
    {%- else -%}
      <div class="cart-empty">
        <p class="cart-empty__text">{{ 'cart.general.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="cart-empty__link">
          {{ 'cart.general.continue_shopping' | t }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_cart.name",
  "tag": "section",
  "class": "section-main-cart",
  "settings": [],
  "presets": [
    {
      "name": "t:sections.main_cart.name"
    }
  ]
}
{% endschema %}
