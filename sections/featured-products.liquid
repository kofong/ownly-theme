{%- style -%}
  .featured-products {
    padding: 6rem 1.5rem;
    background: #F9FAFB;
  }

  .featured-products__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 3rem;
  }

  .featured-products__heading {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 700;
    color: {{ settings.color_primary }};
    margin: 0 0 1rem;
  }

  .featured-products__subheading {
    font-size: 1.1rem;
    color: {{ settings.color_text_light }};
    margin: 0;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .product-card {
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid #E5E7EB;
    transition: all 0.3s ease;
  }

  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(26, 26, 46, 0.1);
  }

  .product-card__image {
    aspect-ratio: 1;
    background: #F3F4F6;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .product-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .product-card:hover .product-card__image img {
    transform: scale(1.05);
  }

  .product-card__placeholder {
    color: {{ settings.color_text_light }};
    font-size: 0.9rem;
  }

  .product-card__info {
    padding: 1.25rem;
  }

  .product-card__title {
    font-size: 1rem;
    font-weight: 600;
    color: {{ settings.color_primary }};
    margin: 0 0 0.5rem;
    line-height: 1.4;
  }

  .product-card__title a {
    text-decoration: none;
    color: inherit;
  }

  .product-card__title a:hover {
    color: {{ settings.color_accent }};
  }

  .product-card__price {
    font-size: 1.1rem;
    font-weight: 700;
    color: {{ settings.color_accent }};
    margin: 0 0 1rem;
  }

  .product-card__btn {
    display: block;
    width: 100%;
    padding: 0.75rem;
    border: none;
    border-radius: 8px;
    background: {{ settings.color_primary }};
    color: #fff;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
    text-align: center;
    text-decoration: none;
  }

  .product-card__btn:hover {
    background: {{ settings.color_accent }};
  }

  @media (max-width: 749px) {
    .featured-products { padding: 4rem 1rem; }
    .product-grid { grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  }
{%- endstyle -%}

<section class="featured-products" id="products-{{ section.id }}">
  <div class="featured-products__header">
    <h2 class="featured-products__heading">{{ section.settings.heading }}</h2>
    <p class="featured-products__subheading">{{ section.settings.subheading }}</p>
  </div>

  <div class="product-grid">
    {%- if section.settings.collection != blank -%}
      {%- assign collection = collections[section.settings.collection] -%}
      {%- for product in collection.products limit: section.settings.products_to_show -%}
        <div class="product-card">
          <div class="product-card__image">
            {%- if product.featured_image -%}
              <img
                src="{{ product.featured_image | image_url: width: 400 }}"
                alt="{{ product.featured_image.alt | escape }}"
                loading="lazy"
                width="400"
                height="400"
              >
            {%- else -%}
              <span class="product-card__placeholder">No image</span>
            {%- endif -%}
          </div>
          <div class="product-card__info">
            <h3 class="product-card__title">
              <a href="{{ product.url }}">{{ product.title }}</a>
            </h3>
            <p class="product-card__price">{{ product.price | money }}</p>
            {%- render 'product-card-button', product: product -%}
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- comment -%} Placeholder cards when no collection selected {%- endcomment -%}
      {%- for i in (1..4) -%}
        <div class="product-card">
          <div class="product-card__image">
            <span class="product-card__placeholder">
              {%- case i -%}
                {%- when 1 -%} Custom T-Shirt
                {%- when 2 -%} Photo Mug
                {%- when 3 -%} Phone Case
                {%- when 4 -%} Canvas Tote
              {%- endcase -%}
            </span>
          </div>
          <div class="product-card__info">
            <h3 class="product-card__title">
              {%- case i -%}
                {%- when 1 -%} Custom T-Shirt
                {%- when 2 -%} Photo Mug
                {%- when 3 -%} Phone Case
                {%- when 4 -%} Canvas Tote Bag
              {%- endcase -%}
            </h3>
            <p class="product-card__price">
              {%- case i -%}
                {%- when 1 -%} $24.99
                {%- when 2 -%} $18.99
                {%- when 3 -%} $15.99
                {%- when 4 -%} $19.99
              {%- endcase -%}
            </p>
            <a href="/collections/all" class="product-card__btn">Customize Now</a>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Start Customizing"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Phase 1 products — ready to ship worldwide"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Select a collection to display products"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to Show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}
