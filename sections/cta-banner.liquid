{%- style -%}
  .cta-banner {
    padding: 6rem 1.5rem;
    background: linear-gradient(135deg, {{ settings.color_primary }} 0%, color-mix(in srgb, {{ settings.color_primary }} 70%, {{ settings.color_ai_purple }}) 100%);
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .cta-banner::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: radial-gradient(circle, {{ settings.color_accent }}15 0%, transparent 70%);
  }

  .cta-banner__content {
    position: relative;
    z-index: 2;
    max-width: 600px;
    margin: 0 auto;
  }

  .cta-banner__heading {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 700;
    color: #fff;
    margin: 0 0 1rem;
  }

  .cta-banner__subheading {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 2.5rem;
    line-height: 1.6;
  }

  .cta-banner__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2.5rem;
    border-radius: 8px;
    background: {{ settings.color_accent }};
    color: #fff;
    font-size: 1.1rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 20px {{ settings.color_accent }}66;
  }

  .cta-banner__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px {{ settings.color_accent }}88;
  }

  @media (max-width: 749px) {
    .cta-banner { padding: 4rem 1rem; }
  }
{%- endstyle -%}

<section class="cta-banner">
  <div class="cta-banner__content">
    <h2 class="cta-banner__heading">{{ section.settings.heading }}</h2>
    <p class="cta-banner__subheading">{{ section.settings.subheading }}</p>
    <a href="{{ section.settings.button_link }}" class="cta-banner__btn">
      {{ section.settings.button_text }}
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </a>
  </div>
</section>

{% schema %}
{
  "name": "CTA Banner",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to Own Your Brand?"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Join hundreds of creators, small businesses, and event organizers who trust Ownly."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Get Started Free"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "CTA Banner"
    }
  ]
}
{% endschema %}
