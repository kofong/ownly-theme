{% stylesheet %}
  .cta-banner {
    padding-block: var(--space-3xl, 6rem);
    padding-inline: 1.5rem;
    background: linear-gradient(135deg, var(--color-primary, #1A1A2E) 0%, color-mix(in srgb, var(--color-primary, #1A1A2E) 70%, var(--color-ai-purple, #8B5CF6)) 100%);
    text-align: center;
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .cta-banner::before {
    content: '';
    position: absolute;
    inset-block-start: -50%;
    inset-inline-end: -20%;
    inline-size: 500px;
    block-size: 500px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-accent, #FF6B35) 8%, transparent) 0%, transparent 70%);
    z-index: -1;
  }

  .cta-banner__content {
    position: relative;
    z-index: 2;
    max-inline-size: 600px;
    margin: 0 auto;
    min-width: 0;
    overflow-wrap: break-word;
  }

  .cta-banner__heading {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 700;
    color: #fff;
    margin: 0 0 var(--space-sm, 1rem);
  }

  .cta-banner__subheading {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.85);
    margin: 0 0 2.5rem;
    line-height: 1.6;
  }

  .cta-banner__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding-block: 1rem;
    padding-inline: 2.5rem;
    border-radius: var(--radius-sm, 8px);
    background: var(--color-accent, #FF6B35);
    color: #fff;
    font-size: 1.1rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 4px 20px color-mix(in srgb, var(--color-accent, #FF6B35) 40%, transparent);
  }

  .cta-banner__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px color-mix(in srgb, var(--color-accent, #FF6B35) 53%, transparent);
  }

  .cta-banner__btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  .cta-banner__btn svg {
    inline-size: 20px;
    block-size: 20px;
  }

  @media screen and (max-width: 749px) {
    .cta-banner {
      padding-block: var(--space-2xl, 4rem);
      padding-inline: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-banner__btn,
    .cta-banner__btn:hover {
      transform: none;
      transition: none;
    }
  }
{% endstylesheet %}

<section class="cta-banner" id="cta-{{ section.id }}">
  <div class="cta-banner__content">
    <h2 class="cta-banner__heading">{{ section.settings.heading }}</h2>
    <p class="cta-banner__subheading">{{ section.settings.subheading }}</p>
    <a href="{{ section.settings.button_link }}" class="cta-banner__btn">
      {{ section.settings.button_text }}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
    </a>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.cta_banner.name",
  "tag": "section",
  "class": "section-cta-banner",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.cta_banner.settings.header_content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.cta_banner.settings.heading",
      "default": "Ready to Own Your Brand?"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:sections.cta_banner.settings.subheading",
      "default": "Join hundreds of creators, small businesses, and event organizers who trust Ownly."
    },
    {
      "type": "header",
      "content": "t:sections.cta_banner.settings.header_button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "t:sections.cta_banner.settings.button_text",
      "default": "Get Started Free"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.cta_banner.settings.button_link"
    }
  ],
  "presets": [
    {
      "name": "t:sections.cta_banner.name",
      "settings": {
        "button_link": "/collections/all"
      }
    }
  ]
}
{% endschema %}
