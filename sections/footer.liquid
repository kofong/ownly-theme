{%- style -%}
  .site-footer {
    background: {{ settings.color_primary }};
    color: rgba(255, 255, 255, 0.8);
    padding: 4rem 1.5rem 2rem;
  }

  .site-footer__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 3rem;
  }

  .site-footer__brand {
    max-width: 280px;
  }

  .site-footer__logo {
    font-size: 1.5rem;
    font-weight: 800;
    color: #fff;
    margin: 0 0 1rem;
  }

  .site-footer__logo span {
    color: {{ settings.color_accent }};
  }

  .site-footer__tagline {
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0 0 1.5rem;
  }

  .site-footer__social {
    display: flex;
    gap: 1rem;
  }

  .site-footer__social a {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: all 0.2s;
  }

  .site-footer__social a:hover {
    background: {{ settings.color_accent }};
    color: #fff;
  }

  .site-footer__col-title {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #fff;
    margin: 0 0 1.25rem;
  }

  .site-footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .site-footer__links li {
    margin-bottom: 0.75rem;
  }

  .site-footer__links a {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: color 0.2s;
  }

  .site-footer__links a:hover {
    color: {{ settings.color_accent }};
  }

  .site-footer__bottom {
    max-width: 1100px;
    margin: 3rem auto 0;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
  }

  .site-footer__bottom a {
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
  }

  @media (max-width: 749px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .site-footer__bottom {
      flex-direction: column;
      gap: 0.5rem;
      text-align: center;
    }
  }
{%- endstyle -%}

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__logo">Own<span>ly</span></p>
      <p class="site-footer__tagline">{{ settings.footer_tagline }}</p>
      <div class="site-footer__social">
        {%- if settings.social_twitter != blank -%}
          <a href="{{ settings.social_twitter }}" aria-label="Twitter" target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        {%- endif -%}
        {%- if settings.social_instagram != blank -%}
          <a href="{{ settings.social_instagram }}" aria-label="Instagram" target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
        {%- endif -%}
        {%- if settings.social_tiktok != blank -%}
          <a href="{{ settings.social_tiktok }}" aria-label="TikTok" target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 00-.79-.05A6.34 6.34 0 003.15 15.2a6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.34-6.34V8.73a8.19 8.19 0 004.76 1.52v-3.4a4.85 4.85 0 01-1-.16z"/></svg>
          </a>
        {%- endif -%}
      </div>
    </div>

    <div>
      <h4 class="site-footer__col-title">Products</h4>
      <ul class="site-footer__links">
        <li><a href="/collections/t-shirts">T-Shirts</a></li>
        <li><a href="/collections/mugs">Mugs</a></li>
        <li><a href="/collections/phone-cases">Phone Cases</a></li>
        <li><a href="/collections/kits">Full Kits</a></li>
      </ul>
    </div>

    <div>
      <h4 class="site-footer__col-title">Company</h4>
      <ul class="site-footer__links">
        <li><a href="/pages/about">About Us</a></li>
        <li><a href="/pages/faq">FAQ</a></li>
        <li><a href="/pages/contact">Contact</a></li>
        <li><a href="/blogs/news">Blog</a></li>
      </ul>
    </div>

    <div>
      <h4 class="site-footer__col-title">Support</h4>
      <ul class="site-footer__links">
        <li><a href="/policies/shipping-policy">Shipping</a></li>
        <li><a href="/policies/refund-policy">Returns</a></li>
        <li><a href="/policies/privacy-policy">Privacy</a></li>
        <li><a href="/policies/terms-of-service">Terms</a></li>
      </ul>
    </div>
  </div>

  <div class="site-footer__bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
    <p>{{ settings.footer_contact_email }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "footer-section",
  "settings": [],
  "blocks": []
}
{% endschema %}
