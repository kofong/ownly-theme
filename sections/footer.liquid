{% stylesheet %}
  .site-footer {
    background: var(--color-primary, #1A1A2E);
    color: rgba(255, 255, 255, 0.8);
    padding-block: 4rem 2rem;
    padding-inline: 1.5rem;
  }

  .site-footer__inner {
    max-inline-size: 1100px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 3rem;
  }

  .site-footer__brand {
    max-inline-size: 280px;
    min-width: 0;
    overflow-wrap: break-word;
  }

  .site-footer__logo {
    font-size: 1.5rem;
    font-weight: 800;
    color: #fff;
    margin: 0 0 var(--space-sm, 1rem);
  }

  .site-footer__logo span {
    color: var(--color-accent, #FF6B35);
  }

  .site-footer__tagline {
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0 0 1.5rem;
    overflow-wrap: break-word;
  }

  .site-footer__social {
    display: flex;
    gap: 1rem;
  }

  .site-footer__social a {
    inline-size: 36px;
    block-size: 36px;
    border-radius: var(--radius-sm, 8px);
    background: rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .site-footer__social a:hover {
    background: var(--color-accent, #FF6B35);
    color: #fff;
  }

  .site-footer__social a:focus-visible {
    outline: 2px solid var(--color-accent, #FF6B35);
    outline-offset: 3px;
  }

  .site-footer__col-title {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #fff;
    margin: 0 0 1.25rem;
  }

  .site-footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .site-footer__links li {
    margin-block-end: 0.75rem;
  }

  .site-footer__links a {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .site-footer__links a:hover {
    color: var(--color-accent, #FF6B35);
  }

  .site-footer__links a:focus-visible {
    outline: 2px solid var(--color-accent, #FF6B35);
    outline-offset: 3px;
  }

  .site-footer__bottom {
    max-inline-size: 1100px;
    margin: 3rem auto 0;
    padding-block-start: 2rem;
    border-block-start: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.8rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .site-footer__bottom a {
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
  }

  @media screen and (max-width: 749px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .site-footer__bottom {
      flex-direction: column;
      text-align: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer__social a,
    .site-footer__links a {
      transition: none;
    }
  }
{% endstylesheet %}

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__logo">Own<span>ly</span></p>
      <p class="site-footer__tagline">{{ settings.footer_tagline }}</p>
      <div class="site-footer__social">
        {%- if settings.social_twitter != blank -%}
          <a href="{{ settings.social_twitter }}" aria-label="Twitter" target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        {%- endif -%}
        {%- if settings.social_instagram != blank -%}
          <a href="{{ settings.social_instagram }}" aria-label="Instagram" target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
        {%- endif -%}
        {%- if settings.social_tiktok != blank -%}
          <a href="{{ settings.social_tiktok }}" aria-label="TikTok" target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 00-.79-.05A6.34 6.34 0 003.15 15.2a6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.34-6.34V8.73a8.19 8.19 0 004.76 1.52v-3.4a4.85 4.85 0 01-1-.16z"/></svg>
          </a>
        {%- endif -%}
      </div>
    </div>

    <nav aria-label="{{ 'sections.footer.products' | t }}">
      <h4 class="site-footer__col-title">{{ 'sections.footer.products' | t }}</h4>
      <ul class="site-footer__links">
        <li><a href="/collections/t-shirts">{{ 'sections.footer.t_shirts' | t }}</a></li>
        <li><a href="/collections/mugs">{{ 'sections.footer.mugs' | t }}</a></li>
        <li><a href="/collections/phone-cases">{{ 'sections.footer.phone_cases' | t }}</a></li>
        <li><a href="/collections/kits">{{ 'sections.footer.full_kits' | t }}</a></li>
      </ul>
    </nav>

    <nav aria-label="{{ 'sections.footer.company' | t }}">
      <h4 class="site-footer__col-title">{{ 'sections.footer.company' | t }}</h4>
      <ul class="site-footer__links">
        <li><a href="/pages/about">{{ 'sections.footer.about_us' | t }}</a></li>
        <li><a href="/pages/faq">{{ 'sections.footer.faq' | t }}</a></li>
        <li><a href="/pages/contact">{{ 'sections.footer.contact' | t }}</a></li>
        <li><a href="/blogs/news">{{ 'sections.footer.blog' | t }}</a></li>
      </ul>
    </nav>

    <nav aria-label="{{ 'sections.footer.support' | t }}">
      <h4 class="site-footer__col-title">{{ 'sections.footer.support' | t }}</h4>
      <ul class="site-footer__links">
        <li><a href="/policies/shipping-policy">{{ 'sections.footer.shipping' | t }}</a></li>
        <li><a href="/policies/refund-policy">{{ 'sections.footer.returns' | t }}</a></li>
        <li><a href="/policies/privacy-policy">{{ 'sections.footer.privacy' | t }}</a></li>
        <li><a href="/policies/terms-of-service">{{ 'sections.footer.terms' | t }}</a></li>
      </ul>
    </nav>
  </div>

  <div class="site-footer__bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'sections.footer.all_rights_reserved' | t }}</p>
    {%- if settings.footer_contact_email != blank -%}
      <p>{{ settings.footer_contact_email }}</p>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "tag": "footer",
  "class": "footer-section",
  "settings": [],
  "blocks": []
}
{% endschema %}
