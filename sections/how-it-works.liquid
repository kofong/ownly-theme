{% stylesheet %}
  .how-it-works {
    padding-block: var(--space-3xl, 6rem);
    padding-inline: 1.5rem;
    background: var(--color-bg-alt, #F9FAFB);
  }

  .how-it-works__header {
    text-align: center;
    max-inline-size: 600px;
    margin: 0 auto var(--space-2xl, 4rem);
  }

  .how-it-works__heading {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 700;
    color: var(--color-primary, #1A1A2E);
    margin: 0 0 var(--space-sm, 1rem);
  }

  .how-it-works__subheading {
    font-size: 1.1rem;
    color: var(--color-text-light, #6B7280);
    margin: 0;
    overflow-wrap: break-word;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    max-inline-size: 1000px;
    margin: 0 auto;
    position: relative;
  }

  .steps::before {
    content: '';
    position: absolute;
    inset-block-start: 40px;
    inset-inline-start: 12.5%;
    inset-inline-end: 12.5%;
    block-size: 2px;
    background: linear-gradient(90deg, var(--color-accent, #FF6B35), var(--color-ai-purple, #8B5CF6));
    z-index: 0;
  }

  .step {
    text-align: center;
    position: relative;
    z-index: 1;
    min-width: 0;
    overflow-wrap: break-word;
  }

  .step__number {
    inline-size: 80px;
    block-size: 80px;
    border-radius: 50%;
    background: #fff;
    border: 3px solid var(--color-accent, #FF6B35);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-accent, #FF6B35);
    margin-block-end: 1.5rem;
    transition: background 0.3s ease, color 0.3s ease, transform 0.3s ease;
  }

  .step:hover .step__number {
    background: var(--color-accent, #FF6B35);
    color: #fff;
    transform: scale(1.1);
  }

  .step__title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-primary, #1A1A2E);
    margin: 0 0 0.5rem;
  }

  .step__text {
    font-size: 0.9rem;
    color: var(--color-text-light, #6B7280);
    line-height: 1.5;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .how-it-works {
      padding-block: var(--space-2xl, 4rem);
      padding-inline: 1rem;
    }

    .steps {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .steps::before {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .step__number,
    .step:hover .step__number {
      transform: none;
      transition: none;
    }
  }
{% endstylesheet %}

<section class="how-it-works" id="how-it-works">
  <div class="how-it-works__header">
    <h2 class="how-it-works__heading">{{ section.settings.heading }}</h2>
    <p class="how-it-works__subheading">{{ section.settings.subheading }}</p>
  </div>

  <div class="steps">
    {%- for block in section.blocks -%}
      <div class="step" {{ block.shopify_attributes }}>
        <div class="step__number">{{ forloop.index }}</div>
        <h3 class="step__title">{{ block.settings.title }}</h3>
        <p class="step__text">{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.how_it_works.name",
  "tag": "section",
  "class": "section-how-it-works",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.how_it_works.settings.header_content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.how_it_works.settings.heading",
      "default": "How It Works"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.how_it_works.settings.subheading",
      "default": "From upload to delivery in 4 simple steps"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:sections.how_it_works.blocks.step.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.how_it_works.blocks.step.settings.title",
          "default": "Step Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.how_it_works.blocks.step.settings.text",
          "default": "Step description."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.how_it_works.name",
      "blocks": [
        { "type": "step", "settings": { "title": "Upload", "text": "Drop your logo, artwork, or any image. We accept PNG, JPG, SVG." } },
        { "type": "step", "settings": { "title": "Customize", "text": "AI adapts your design to fit each product perfectly. Preview in real-time." } },
        { "type": "step", "settings": { "title": "Order", "text": "Pick individual items or grab a full Kit. Secure checkout via PayPal." } },
        { "type": "step", "settings": { "title": "Receive", "text": "We produce and ship worldwide. Tracking included. 7-15 day delivery." } }
      ]
    }
  ]
}
{% endschema %}
