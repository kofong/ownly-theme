{%- style -%}
  .how-it-works {
    padding: 6rem 1.5rem;
    background: #F9FAFB;
  }

  .how-it-works__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 4rem;
  }

  .how-it-works__heading {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 700;
    color: {{ settings.color_primary }};
    margin: 0 0 1rem;
  }

  .how-it-works__subheading {
    font-size: 1.1rem;
    color: {{ settings.color_text_light }};
    margin: 0;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    max-width: 1000px;
    margin: 0 auto;
    position: relative;
  }

  .steps::before {
    content: '';
    position: absolute;
    top: 40px;
    left: 12.5%;
    right: 12.5%;
    height: 2px;
    background: linear-gradient(90deg, {{ settings.color_accent }}, {{ settings.color_ai_purple }});
    z-index: 0;
  }

  .step {
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .step__number {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: #fff;
    border: 3px solid {{ settings.color_accent }};
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 800;
    color: {{ settings.color_accent }};
    margin-bottom: 1.5rem;
    transition: all 0.3s ease;
  }

  .step:hover .step__number {
    background: {{ settings.color_accent }};
    color: #fff;
    transform: scale(1.1);
  }

  .step__title {
    font-size: 1.05rem;
    font-weight: 700;
    color: {{ settings.color_primary }};
    margin: 0 0 0.5rem;
  }

  .step__text {
    font-size: 0.9rem;
    color: {{ settings.color_text_light }};
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 749px) {
    .how-it-works { padding: 4rem 1rem; }
    .steps {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .steps::before { display: none; }
  }
{%- endstyle -%}

<section class="how-it-works" id="how-it-works">
  <div class="how-it-works__header">
    <h2 class="how-it-works__heading">{{ section.settings.heading }}</h2>
    <p class="how-it-works__subheading">{{ section.settings.subheading }}</p>
  </div>

  <div class="steps">
    <div class="step">
      <div class="step__number">1</div>
      <h3 class="step__title">Upload</h3>
      <p class="step__text">Drop your logo, artwork, or any image. We accept PNG, JPG, SVG.</p>
    </div>
    <div class="step">
      <div class="step__number">2</div>
      <h3 class="step__title">Customize</h3>
      <p class="step__text">AI adapts your design to fit each product perfectly. Preview in real-time.</p>
    </div>
    <div class="step">
      <div class="step__number">3</div>
      <h3 class="step__title">Order</h3>
      <p class="step__text">Pick individual items or grab a full Kit. Secure checkout via PayPal.</p>
    </div>
    <div class="step">
      <div class="step__number">4</div>
      <h3 class="step__title">Receive</h3>
      <p class="step__text">We produce and ship worldwide. Tracking included. 7-15 day delivery.</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How It Works",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "How It Works"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "From upload to delivery in 4 simple steps"
    }
  ],
  "presets": [
    {
      "name": "How It Works"
    }
  ]
}
{% endschema %}
