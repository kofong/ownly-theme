{%- style -%}
  .hero-banner {
    --hero-bg: {{ section.settings.color_scheme == 'primary' ? settings.color_primary : settings.color_accent }};
    --hero-text: #FFFFFF;
    position: relative;
    min-height: 85vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: linear-gradient(135deg, var(--hero-bg) 0%, color-mix(in srgb, var(--hero-bg) 70%, #000) 100%);
    overflow: hidden;
    padding: 4rem 1.5rem;
  }

  .hero-banner::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -20%;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: radial-gradient(circle, {{ settings.color_accent }}22 0%, transparent 70%);
    animation: hero-float 8s ease-in-out infinite;
  }

  .hero-banner::after {
    content: '';
    position: absolute;
    bottom: -30%;
    left: -10%;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, {{ settings.color_ai_purple }}18 0%, transparent 70%);
    animation: hero-float 10s ease-in-out infinite reverse;
  }

  @keyframes hero-float {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-30px) scale(1.05); }
  }

  .hero-banner__content {
    position: relative;
    z-index: 2;
    max-width: 800px;
  }

  .hero-banner__heading {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800;
    color: var(--hero-text);
    line-height: 1.1;
    margin: 0 0 1.5rem;
    letter-spacing: -0.02em;
  }

  .hero-banner__heading span {
    background: linear-gradient(135deg, {{ settings.color_accent }}, {{ settings.color_ai_purple }});
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-banner__subheading {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.6;
    margin: 0 0 2.5rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-banner__buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero-banner__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    border-radius: 8px;
    font-size: 1.05rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    cursor: pointer;
    border: none;
  }

  .hero-banner__btn--primary {
    background: {{ settings.color_accent }};
    color: #fff;
    box-shadow: 0 4px 20px {{ settings.color_accent }}66;
  }

  .hero-banner__btn--primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px {{ settings.color_accent }}88;
  }

  .hero-banner__btn--secondary {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
    border: 1.5px solid rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(4px);
  }

  .hero-banner__btn--secondary:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.5);
  }

  @media (max-width: 749px) {
    .hero-banner { min-height: 70vh; padding: 3rem 1rem; }
    .hero-banner__buttons { flex-direction: column; align-items: center; }
    .hero-banner__btn { width: 100%; max-width: 280px; justify-content: center; }
  }
{%- endstyle -%}

<section class="hero-banner" id="hero-{{ section.id }}">
  <div class="hero-banner__content">
    <h1 class="hero-banner__heading">
      {{ section.settings.heading }}
    </h1>
    <p class="hero-banner__subheading">{{ section.settings.subheading }}</p>
    <div class="hero-banner__buttons">
      <a href="{{ section.settings.button_link }}" class="hero-banner__btn hero-banner__btn--primary">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        {{ section.settings.button_text }}
      </a>
      <a href="{{ section.settings.secondary_button_link }}" class="hero-banner__btn hero-banner__btn--secondary">
        {{ section.settings.secondary_button_text }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Upload once, own everything."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "One logo → full brand kit. T-shirts, mugs, phone cases & more — auto-generated, zero design skills needed."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Primary Button Text",
      "default": "Start Creating"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_button_text",
      "label": "Secondary Button Text",
      "default": "See How It Works"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color Scheme",
      "options": [
        { "value": "primary", "label": "Primary (Navy)" },
        { "value": "accent", "label": "Accent (Orange)" }
      ],
      "default": "primary"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
