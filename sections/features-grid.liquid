{% stylesheet %}
  .features-grid {
    padding-block: var(--space-3xl, 6rem);
    padding-inline: 1.5rem;
    background: var(--color-bg, #FFFFFF);
  }

  .features-grid__header {
    text-align: center;
    max-inline-size: 600px;
    margin: 0 auto var(--space-2xl, 4rem);
  }

  .features-grid__heading {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 700;
    color: var(--color-primary, #1A1A2E);
    margin: 0 0 var(--space-sm, 1rem);
  }

  .features-grid__subheading {
    font-size: 1.1rem;
    color: var(--color-text-light, #6B7280);
    margin: 0;
    line-height: 1.6;
    overflow-wrap: break-word;
  }

  .features-grid__items {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2.5rem;
    max-inline-size: 1100px;
    margin: 0 auto;
  }

  .feature-card {
    text-align: center;
    padding: 2.5rem 2rem;
    border-radius: var(--radius-lg, 20px);
    background: var(--color-bg-alt, #F9FAFB);
    border: 1px solid var(--color-border, #E5E7EB);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    min-width: 0;
    overflow-wrap: break-word;
    isolation: isolate;
  }

  .feature-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md, 0 8px 30px rgba(0,0,0,0.08));
    border-color: color-mix(in srgb, var(--color-accent, #FF6B35) 27%, transparent);
  }

  .feature-card__icon {
    inline-size: 64px;
    block-size: 64px;
    border-radius: var(--radius-lg, 20px);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-block-end: 1.5rem;
    background: linear-gradient(135deg, var(--color-primary, #1A1A2E), var(--color-ai-purple, #8B5CF6));
  }

  .feature-card__icon svg {
    inline-size: 28px;
    block-size: 28px;
    color: #fff;
  }

  .feature-card__title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary, #1A1A2E);
    margin: 0 0 0.75rem;
  }

  .feature-card__text {
    font-size: 0.95rem;
    color: var(--color-text-light, #6B7280);
    line-height: 1.6;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .features-grid {
      padding-block: var(--space-2xl, 4rem);
      padding-inline: 1rem;
    }

    .features-grid__items {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-card,
    .feature-card:hover {
      transform: none;
      transition: none;
    }
  }
{% endstylesheet %}

<section class="features-grid" id="features-{{ section.id }}">
  <div class="features-grid__header">
    <h2 class="features-grid__heading">{{ section.settings.heading }}</h2>
    <p class="features-grid__subheading">{{ section.settings.subheading }}</p>
  </div>

  <div class="features-grid__items">
    {%- for block in section.blocks -%}
      <div class="feature-card" {{ block.shopify_attributes }}>
        <div class="feature-card__icon">
          {%- case block.settings.icon -%}
            {%- when 'upload' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            {%- when 'magic' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 4V2"/><path d="M15 16v-2"/><path d="M8 9h2"/><path d="M20 9h2"/><path d="M17.8 11.8L19 13"/><path d="M15 9h0"/><path d="M17.8 6.2L19 5"/><path d="M11 6.2L9.7 5"/><path d="M12 20l6.5-6.5L14 9l-2 2-4.5-4.5L1 13l6.5 6.5z"/></svg>
            {%- when 'package' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M16.5 9.4l-9-5.19"/><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 002 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
          {%- endcase -%}
        </div>
        <h3 class="feature-card__title">{{ block.settings.title }}</h3>
        <p class="feature-card__text">{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.features_grid.name",
  "tag": "section",
  "class": "section-features-grid",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.features_grid.settings.header_content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.features_grid.settings.heading",
      "default": "Why Ownly?"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:sections.features_grid.settings.subheading",
      "default": "The world's first one-logo-to-everything platform"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "t:sections.features_grid.blocks.feature.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.features_grid.blocks.feature.settings.icon",
          "options": [
            { "value": "upload", "label": "t:sections.features_grid.blocks.feature.settings.icon_upload" },
            { "value": "magic", "label": "t:sections.features_grid.blocks.feature.settings.icon_magic" },
            { "value": "package", "label": "t:sections.features_grid.blocks.feature.settings.icon_package" }
          ],
          "default": "upload"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.features_grid.blocks.feature.settings.title",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:sections.features_grid.blocks.feature.settings.text",
          "default": "Feature description goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.features_grid.name",
      "blocks": [
        { "type": "feature", "settings": { "icon": "upload", "title": "Upload Your Logo", "text": "Drop any image — we handle the rest. No design tools, no templates, no hassle." } },
        { "type": "feature", "settings": { "icon": "magic", "title": "AI Auto-Adapts", "text": "Our AI instantly adapts your design to fit every product perfectly. One upload, infinite possibilities." } },
        { "type": "feature", "settings": { "icon": "package", "title": "Full Kit Delivery", "text": "Order individual items or complete kits. Campaign swag, wedding favors, brand merch — all in one click." } }
      ]
    }
  ]
}
{% endschema %}
