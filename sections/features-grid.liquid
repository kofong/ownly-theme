{%- style -%}
  .features-grid {
    padding: 6rem 1.5rem;
    background: {{ settings.color_background }};
  }

  .features-grid__header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 4rem;
  }

  .features-grid__heading {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 700;
    color: {{ settings.color_primary }};
    margin: 0 0 1rem;
  }

  .features-grid__subheading {
    font-size: 1.1rem;
    color: {{ settings.color_text_light }};
    margin: 0;
    line-height: 1.6;
  }

  .features-grid__items {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2.5rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  .feature-card {
    text-align: center;
    padding: 2.5rem 2rem;
    border-radius: 16px;
    background: #FAFBFC;
    border: 1px solid #E5E7EB;
    transition: all 0.3s ease;
  }

  .feature-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(26, 26, 46, 0.08);
    border-color: {{ settings.color_accent }}44;
  }

  .feature-card__icon {
    width: 64px;
    height: 64px;
    border-radius: 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    background: linear-gradient(135deg, {{ settings.color_primary }}, {{ settings.color_ai_purple }});
  }

  .feature-card__icon svg {
    width: 28px;
    height: 28px;
    color: #fff;
  }

  .feature-card__title {
    font-size: 1.25rem;
    font-weight: 700;
    color: {{ settings.color_primary }};
    margin: 0 0 0.75rem;
  }

  .feature-card__text {
    font-size: 0.95rem;
    color: {{ settings.color_text_light }};
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 749px) {
    .features-grid { padding: 4rem 1rem; }
    .features-grid__items { grid-template-columns: 1fr; gap: 1.5rem; }
  }
{%- endstyle -%}

<section class="features-grid" id="features-{{ section.id }}">
  <div class="features-grid__header">
    <h2 class="features-grid__heading">{{ section.settings.heading }}</h2>
    <p class="features-grid__subheading">{{ section.settings.subheading }}</p>
  </div>

  <div class="features-grid__items">
    {%- for block in section.blocks -%}
      <div class="feature-card" {{ block.shopify_attributes }}>
        <div class="feature-card__icon">
          {%- case block.settings.icon -%}
            {%- when 'upload' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            {%- when 'magic' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 4V2"/><path d="M15 16v-2"/><path d="M8 9h2"/><path d="M20 9h2"/><path d="M17.8 11.8L19 13"/><path d="M15 9h0"/><path d="M17.8 6.2L19 5"/><path d="M11 6.2L9.7 5"/><path d="M12 20l6.5-6.5L14 9l-2 2-4.5-4.5L1 13l6.5 6.5z"/></svg>
            {%- when 'package' -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16.5 9.4l-9-5.19"/><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 002 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
          {%- endcase -%}
        </div>
        <h3 class="feature-card__title">{{ block.settings.title }}</h3>
        <p class="feature-card__text">{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Features Grid",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Ownly?"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "The world's first one-logo-to-everything platform"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "upload", "label": "Upload" },
            { "value": "magic", "label": "AI Magic" },
            { "value": "package", "label": "Package" }
          ],
          "default": "upload"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Feature description goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Features Grid",
      "blocks": [
        { "type": "feature", "settings": { "icon": "upload", "title": "Upload Your Logo", "text": "Drop any image — we handle the rest." } },
        { "type": "feature", "settings": { "icon": "magic", "title": "AI Auto-Adapts", "text": "Our AI instantly adapts your design to every product." } },
        { "type": "feature", "settings": { "icon": "package", "title": "Full Kit Delivery", "text": "Order individual items or complete kits." } }
      ]
    }
  ]
}
{% endschema %}
