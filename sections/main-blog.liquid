{% stylesheet %}
  .blog-page {
    padding-block: var(--space-2xl, 4rem);
    padding-inline: 1.5rem;
  }

  .blog-page__inner {
    max-inline-size: 1100px;
    margin-inline: auto;
  }

  .blog-page__title {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    font-weight: 700;
    color: var(--color-primary, #1A1A2E);
    margin: 0 0 var(--space-2xl, 4rem);
    text-align: center;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-lg, 2rem);
  }

  .article-card {
    border-radius: var(--radius-md, 12px);
    overflow: hidden;
    border: 1px solid var(--color-border, #E5E7EB);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    min-inline-size: 0;
    isolation: isolate;
  }

  .article-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md, 0 8px 30px rgba(0,0,0,0.08));
  }

  .article-card__image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-bg-alt, #F9FAFB);
  }

  .article-card__image img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .article-card:hover .article-card__image img {
    transform: scale(1.05);
  }

  .article-card__body {
    padding: var(--space-md, 1.5rem);
    min-inline-size: 0;
    overflow-wrap: break-word;
  }

  .article-card__date {
    font-size: 0.8rem;
    color: var(--color-text-light, #6B7280);
    margin-block-end: var(--space-2xs, 0.5rem);
  }

  .article-card__title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-primary, #1A1A2E);
    margin: 0 0 var(--space-xs, 0.75rem);
    overflow-wrap: break-word;
  }

  .article-card__title a:hover {
    color: var(--color-accent, #FF6B35);
  }

  .article-card__excerpt {
    font-size: 0.9rem;
    color: var(--color-text-light, #6B7280);
    line-height: 1.6;
    margin: 0 0 var(--space-sm, 1rem);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-card__link {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-accent, #FF6B35);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }

  .article-card__link:hover {
    color: var(--color-primary, #1A1A2E);
  }

  @media (prefers-reduced-motion: reduce) {
    .article-card, .article-card:hover { transform: none; transition: none; }
    .article-card__image img { transition: none; }
  }
{% endstylesheet %}

<section class="blog-page" id="BlogPage-{{ section.id }}">
  <div class="blog-page__inner">
    <h1 class="blog-page__title">{{ blog.title }}</h1>

    {%- if blog.articles.size > 0 -%}
      <div class="blog-grid">
        {%- for article in blog.articles -%}
          <article class="article-card">
            {%- if article.image -%}
              <div class="article-card__image">
                <a href="{{ article.url }}">
                  {{ article.image | image_url: width: 600 | image_tag:
                    loading: 'lazy',
                    alt: article.image.alt | default: article.title | escape,
                    width: article.image.width,
                    height: article.image.height
                  }}
                </a>
              </div>
            {%- endif -%}
            <div class="article-card__body">
              <p class="article-card__date">
                {{ article.published_at | date: '%B %d, %Y' }}
              </p>
              <h2 class="article-card__title">
                <a href="{{ article.url }}">{{ article.title }}</a>
              </h2>
              {%- if article.excerpt != blank -%}
                <p class="article-card__excerpt">{{ article.excerpt | strip_html | truncatewords: 25 }}</p>
              {%- endif -%}
              <a href="{{ article.url }}" class="article-card__link">
                {{ 'blogs.article.read_more' | t }}
              </a>
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p style="text-align: center; color: var(--color-text-light, #6B7280);">
        {{ 'blogs.general.no_articles' | t }}
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_blog.name",
  "tag": "section",
  "class": "section-main-blog",
  "settings": [],
  "presets": [
    {
      "name": "t:sections.main_blog.name"
    }
  ]
}
{% endschema %}
