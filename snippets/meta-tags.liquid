{%- comment -%}
  SEO meta tags snippet
{%- endcomment -%}

{%- if page_description -%}
  <meta property="og:description" content="{{ page_description | escape }}">
{%- endif -%}

<meta property="og:type" content="{% if template == 'product' %}product{% else %}website{% endif %}">
<meta property="og:title" content="{{ page_title | escape }}">
<meta property="og:url" content="{{ canonical_url }}">

{%- if settings.logo != blank -%}
  <meta property="og:image" content="{{ settings.logo | image_url: width: 1200 }}">
{%- endif -%}

{%- if template == 'product' and product.featured_image != blank -%}
  <meta property="og:image" content="{{ product.featured_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="1200">
  <meta property="product:price:amount" content="{{ product.price | money_without_currency }}">
  <meta property="product:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ page_title | escape }}">
