      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent Color",
        "default": "#FF6B35",
        "info": "Vibrant orange — creativity, action"
      },
      {
        "type": "color",
        "id": "color_ai_purple",
        "label": "AI Purple",
        "default": "#8B5CF6",
        "info": "AI Studio accent color"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Background Color",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text Color",
        "default": "#1A1A2E"
      },
      {
        "type": "color",
        "id": "color_text_light",
        "label": "Light Text Color",
        "default": "#6B7280"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading Font",
        "default": "assistant_n4"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body Font",
        "default": "assistant_n4"
      }
    ]
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo Image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo Width",
        "min": 50,
        "max": 250,
        "step": 10,
        "default": 120,
        "unit": "px"
      },
      {
        "type": "text",
        "id": "logo_text",
        "label": "Logo Text (if no image)",
        "default": "Ownly"
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "text",
        "id": "social_twitter",
        "label": "Twitter/X URL"
      },
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL"
      },
      {
        "type": "text",
        "id": "social_tiktok",
        "label": "TikTok URL"
      }
    ]
  },
  {
    "name": "Footer",
    "settings": [
      {
        "type": "textarea",
        "id": "footer_tagline",
        "label": "Footer Tagline",
        "default": "Upload once, own everything."
      },
      {
        "type": "text",
        "id": "footer_contact_email",
        "label": "Contact Email",
        "default": "hello@ownly.com"
      }
    ]
  }
